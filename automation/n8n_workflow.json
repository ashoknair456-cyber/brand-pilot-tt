{
    "name": "BrandPilot Social Scraper & DB Sync",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "analyze-brand",
                "options": {}
            },
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "model": "gemini-pro",
                "prompt": "={{ $json.body.prompt }}",
                "options": {}
            },
            "name": "Gemini AI",
            "type": "n8n-nodes-base.googleGemini",
            "typeVersion": 1,
            "position": [
                450,
                300
            ],
            "credentials": {
                "googlePalmApi": {
                    "id": "YOUR_GEMINI_CREDENTIAL_ID",
                    "name": "Google Gemini Account"
                }
            }
        },
        {
            "parameters": {
                "operation": "upsert",
                "collection": "brands",
                "key": "name",
                "fields": "name, metrics, lastUpdated",
                "options": {}
            },
            "name": "MongoDB Save",
            "type": "n8n-nodes-base.mongoDb",
            "typeVersion": 1,
            "position": [
                650,
                300
            ],
            "credentials": {
                "mongoDb": {
                    "id": "YOUR_MONGODB_CREDENTIAL_ID",
                    "name": "MongoDB Account"
                }
            }
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ $json }}"
            },
            "name": "Respond to Webhook",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                850,
                300
            ]
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Gemini AI",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gemini AI": {
            "main": [
                [
                    {
                        "node": "MongoDB Save",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "MongoDB Save": {
            "main": [
                [
                    {
                        "node": "Respond to Webhook",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}