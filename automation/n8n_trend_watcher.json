{
    "name": "BrandPilot Industry Trend Watcher",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "trend-watcher",
                "options": {}
            },
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://news.google.com/rss/search?q={{$json.body.topic}}",
                "options": {}
            },
            "name": "RSS Feed Read",
            "type": "n8n-nodes-base.rssFeedRead",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "functionCode": "return items.slice(0, 5);"
            },
            "name": "Limit to Top 5",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "model": "gemini-pro",
                "prompt": "Summarize these 5 news headlines into a 3-bullet market pulse briefing for a marketing dashboard:\n\n{{ $json.title }} - {{ $json.contentSnippet }}",
                "options": {}
            },
            "name": "Gemini Summarizer",
            "type": "n8n-nodes-base.googleGemini",
            "typeVersion": 1,
            "position": [
                850,
                300
            ],
            "credentials": {
                "googlePalmApi": {
                    "id": "YOUR_GEMINI_CREDENTIAL_ID",
                    "name": "Google Gemini Account"
                }
            }
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ $json }}"
            },
            "name": "Respond to App",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1050,
                300
            ]
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "RSS Feed Read",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "RSS Feed Read": {
            "main": [
                [
                    {
                        "node": "Limit to Top 5",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Limit to Top 5": {
            "main": [
                [
                    {
                        "node": "Gemini Summarizer",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gemini Summarizer": {
            "main": [
                [
                    {
                        "node": "Respond to App",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}