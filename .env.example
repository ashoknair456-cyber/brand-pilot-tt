# ==========================================
# BrandPilot AI - Environment Configuration
# ==========================================

# Server Ports & URLs
PORT=5005
FRONTEND_URL=http://localhost:3200
JWT_SECRET=brandpilot_jwt_secret_key_2026

# ==========================================
# Google OAuth 2.0 (OpenID Connect)
# ==========================================
# 1. Obtain Client ID & Client Secret from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Frontend & Backend Client ID:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. Google Client Secret (Backend ONLY - NEVER exposed to frontend):
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Google OAuth Redirect URI:
# For localhost: http://localhost:3200/#/auth/google/callback
# For production: https://yourdomain.com/#/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3200/#/auth/google/callback

# ==========================================
# Google Gemini AI API
# ==========================================
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# Email Service (Optional for OTP delivery)
# ==========================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
