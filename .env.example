# ==========================================
# BrandPilot AI - Environment Configuration
# ==========================================

# Server Ports & URLs
PORT=5005
FRONTEND_URL=http://localhost:3200
JWT_SECRET=brandpilot_jwt_secret_key_production_2026

# Database
DATABASE_URL=./brandpilot.db

# ==========================================
# Google OAuth 2.0 (OpenID Connect)
# ==========================================
# 1. Obtain Client ID & Client Secret from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Frontend & Backend Client ID:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. Google Client Secret (Backend ONLY - NEVER exposed to frontend):
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Google OAuth Redirect URI:
GOOGLE_REDIRECT_URI=http://localhost:3200/#/auth/google/callback

# ==========================================
# Google Gemini AI API
# ==========================================
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# SMTP / Email Service (For OTP delivery & Alerts)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ==========================================
# Automation Webhooks
# ==========================================
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/brandpilot
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/123456/abcdef

# ==========================================
# AI Image Editing / Generation (Optional)
# ==========================================
IMAGE_MODEL_API_KEY=your-image-api-key
